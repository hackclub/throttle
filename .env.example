# Optional: send waitlist signups to Airtable instead of .data/waitlist.json
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Waitlist

# Optional: where the .data/ folder goes when Airtable isn't set (must be writable)
WAITLIST_DIR=

# Any Postgres connection string: Neon, Supabase, or one on Coolify/Orchard.
# Leave empty locally to use an embedded database in .data/pglite. Required in
# production (the server refuses to start a session without it).
DATABASE_URL=

# Run migrations when the server boots. The Dockerfile sets this to true for
# Coolify/Orchard. On Vercel, run `npm run db:migrate` yourself instead.
MIGRATE_ON_START=
# Optional direct (unpooled) URL for migrations, if DATABASE_URL goes through
# a transaction pooler (e.g. Neon's -pooler host or PgBouncer).
MIGRATE_DATABASE_URL=
# Optional connection pool size. Defaults to 1 on Vercel and 10 elsewhere.
DB_POOL_MAX=

# Cloudflare R2 for photo and video uploads. Leave empty locally and files are saved to public/uploads instead.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Hack Club Auth (OIDC). Register the redirect URI <APP_URL>/api/auth/callback.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Defaults to https://auth.hackclub.com
HCA_ISSUER=

# Public base URL of this site, no trailing slash. Defaults to http://localhost:3000
APP_URL=

# Set to true to swap the landing page RSVP card for a "Start your aircraft" button.
NEXT_PUBLIC_LAUNCHED=

# Comma-separated emails, case-insensitive. Applied on every sign-in; people
# not listed keep whatever role they already have.
REVIEWER_EMAILS=
ADMIN_EMAILS=
