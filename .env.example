# Optional: send waitlist signups to Airtable instead of .data/waitlist.json
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Waitlist

# Optional: where the .data/ folder goes when Airtable isn't set (must be writable)
WAITLIST_DIR=

# Postgres (Neon) connection string. Leave empty locally to use an embedded
# PGlite database in .data/pglite (migrations in ./drizzle run automatically).
DATABASE_URL=

# Cloudflare R2 for photo and video uploads. Leave empty locally and files are saved to public/uploads instead.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Hack Club Auth (OIDC). Register the redirect URI <APP_URL>/api/auth/callback.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Defaults to https://auth.hackclub.com
HCA_ISSUER=

# Public base URL of this site, no trailing slash. Defaults to http://localhost:3000
APP_URL=

# Set to true to swap the landing page RSVP card for a "Start your aircraft" button.
NEXT_PUBLIC_LAUNCHED=

# Comma-separated emails, case-insensitive. Applied on every sign-in; people
# not listed keep whatever role they already have.
REVIEWER_EMAILS=
ADMIN_EMAILS=
